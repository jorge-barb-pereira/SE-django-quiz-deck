# Optional overrides. Django reads process environment; this file is not auto-loaded.
DJANGO_DEBUG=1
# Generate your own key for persistent sessions; never use an example in production.
# DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local demonstration default: messages appear in the server terminal.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SMTP variables, when configuring your own provider:
# DJANGO_EMAIL_HOST=
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=
